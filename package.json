{
  "name": "beats-sdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --project unit",
    "test:browser": "pnpm run build && vitest run --project browser",
    "test:all": "pnpm run build && vitest run",
    "size": "node scripts/size.mjs",
    "copy-asset": "node scripts/copy-asset.mjs",
    "check": "pnpm run build && pnpm run typecheck && vitest run && node scripts/size.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "happy-dom": "21.0.4",
    "playwright": "1.63.0",
    "terser": "^5.51.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
