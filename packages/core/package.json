{
  "name": "@beats-analytics/core",
  "version": "0.1.0",
  "description": "Shared event types, item model, validation and normalization of the beats clients (internal).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
