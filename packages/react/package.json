{
  "name": "@revenexx/beats-react",
  "version": "0.1.0",
  "description": "React provider and hook for the beats browser client.",
  "license": "MIT",
  "homepage": "https://github.com/revenexx/beats-sdks/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revenexx/beats-sdks.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/revenexx/beats-sdks/issues"
  },
  "keywords": [
    "beats",
    "analytics",
    "react",
    "nextjs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@revenexx/beats-browser": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
