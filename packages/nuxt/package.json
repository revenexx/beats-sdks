{
  "name": "@beats-analytics/nuxt",
  "version": "0.1.0",
  "description": "Nuxt 3 and 4 module for the beats browser client.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/module.cjs",
  "module": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/module.d.ts", "default": "./dist/module.js" },
      "require": { "types": "./dist/module.d.cts", "default": "./dist/module.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@beats-analytics/browser": "workspace:*",
    "@beats-analytics/vue": "workspace:*",
    "@nuxt/kit": "^3.15.0 || ^4.0.0",
    "@nuxt/schema": "^3.15.0 || ^4.0.0"
  },
  "devDependencies": {
    "vue": "3.5.45",
    "vue-router": "4.6.5"
  }
}
