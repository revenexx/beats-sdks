{
  "name": "@revenexx/beats-browser",
  "version": "0.1.0",
  "description": "Browser client of beats: web, product and e-commerce analytics.",
  "license": "MIT",
  "homepage": "https://github.com/revenexx/beats-sdks/tree/main/packages/browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revenexx/beats-sdks.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/revenexx/beats-sdks/issues"
  },
  "keywords": [
    "beats",
    "analytics",
    "web-analytics",
    "product-analytics",
    "ecommerce",
    "cookieless",
    "browser"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/beats.full.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lite": {
      "import": {
        "types": "./dist/lite.d.ts",
        "default": "./dist/lite.js"
      },
      "require": {
        "types": "./dist/lite.d.cts",
        "default": "./dist/lite.cjs"
      }
    },
    "./beats.js": "./dist/beats.js",
    "./beats.full.js": "./dist/beats.full.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@revenexx/beats-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
